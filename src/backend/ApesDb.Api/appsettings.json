{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=apesdb;Username=apesdb;Password=apesdb"
  },
  "Cache": {
    "ConnectionString": "localhost:6379",
    "Password": "apesdb"
  },
  "ReverseProxy": {
    "Routes": {
      "otlp-traces": {
        "ClusterId": "otlp",
        "Match": {
          "Path": "/otlp/v1/traces"
        },
        "Transforms": [{ "PathSet": "/v1/traces" }]
      }
    },
    "Clusters": {
      "otlp": {
        "Destinations": {
          "collector": {
            "Address": "http://localhost:4318"
          }
        }
      }
    }
  }
}
